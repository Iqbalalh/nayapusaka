{
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",

    "outDir": "dist",
    "rootDir": "src",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node", "multer", "jest"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
