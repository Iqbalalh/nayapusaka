generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
enum Gender {
  M
  F
}

model Children {
  id                Int       @id @default(autoincrement())
  homeId            Int?      @map("home_id")
  childrenName      String    @map("children_name") @db.VarChar(150)
  isActive          Boolean?  @default(true) @map("is_active")
  childrenBirthdate DateTime? @map("children_birthdate") @db.Date
  childrenAddress   String?   @map("children_address")
  childrenPhone     String?   @map("children_phone") @db.VarChar(30)
  notes             String?
  isFatherAlive     Boolean?  @map("is_father_alive")
  isMotherAlive     Boolean?  @map("is_mother_alive")
  childrenGender    Gender?   @map("children_gender")
  isCondition       Boolean?  @map("is_condition")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  childrenPict      String?   @map("children_pict") @db.VarChar(255)
  index             Int?
  nik               String?   @db.VarChar(30)
  childrenJob       String?   @map("children_job") @db.VarChar(50)
  educationLevel    String?   @map("education_level") @db.VarChar(100)
  schoolName        String?   @map("school_name") @db.VarChar(200)
  educationGrade    String?   @map("education_grade") @db.VarChar(100)
  createdBy         Int?      @map("created_by") @default(2)
  editedBy          Int?      @map("edited_by")

  // Relations
  homes            Homes?               @relation(fields: [homeId], references: [id], onUpdate: NoAction)
  umkm             Umkm[]
  childAssistance  ChildAssistance[]

  @@map("childrens")
}


model Employees {
  id             Int      @id @default(autoincrement())
  nipNipp        String?  @unique @map("nip_nipp") @db.VarChar(20)
  employeeName   String?  @map("employee_name") @db.VarChar(100)
  deathCause     String?  @map("death_cause") @db.VarChar(100)
  lastPosition   String?  @map("last_position") @db.VarChar(100)
  regionId       Int?     @map("region_id")
  notes          String?
  employeeGender Gender?  @map("employee_gender")
  isAccident     Boolean? @map("is_accident")
  employeePict   String?  @map("employee_pict") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      Int?     @map("created_by") @default(2)
  editedBy       Int?     @map("edited_by")

  // Relations
  regions  Regions?   @relation(fields: [regionId], references: [regionId], onUpdate: NoAction)
  homes    Homes[]
  partners Partners[]
  umkm     Umkm[]
  wali     Wali[]

  @@map("employees")
}

model Homes {
  id         Int       @id @default(autoincrement())
  partnerId  Int?      @map("partner_id")
  employeeId Int?      @map("employee_id")
  waliId     Int?      @map("wali_id")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  regionId   Int?      @map("region_id")
  postalCode String?   @map("postal_code") @db.VarChar(5)
  createdBy  Int?      @map("created_by") @default(2)
  editedBy   Int?      @map("edited_by")

  // Relations
  children      Children[]
  regions       Regions?   @relation(fields: [regionId], references: [regionId], map: "fk_homes_region")
  employees     Employees? @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  partners      Partners?  @relation(fields: [partnerId], references: [id], onUpdate: NoAction)
  wali          Wali?      @relation(fields: [waliId], references: [id], onUpdate: NoAction)
  familyVisits  FamilyVisit[]

  @@map("homes")
}

model Partners {
  id             Int      @id(map: "employee_partners_pkey") @default(autoincrement())
  employeeId     Int?     @map("employee_id")
  partnerName    String?  @map("partner_name") @db.VarChar(150)
  partnerJob     String?  @map("partner_job") @db.VarChar(100)
  partnerNik     String?  @map("partner_nik") @db.VarChar(30)
  regionId        Int?     @map("region_id")
  address         String?
  subdistrictName String?  @map("subdistrict_name") @db.VarChar(150)
  postalCode      String?  @map("postal_code") @db.VarChar(10)
  homeCoordinate String?  @map("home_coordinate") @db.VarChar(50)
  phoneNumber    String?  @map("phone_number") @db.VarChar(20)
  phoneNumberAlt String?  @map("phone_number_alt") @db.VarChar(20)
  isActive       Boolean? @default(true) @map("is_active")
  isAlive        Boolean? @map("is_alive")
  partnerPict    String?  @map("partner_pict") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      Int?     @map("created_by") @default(2)
  editedBy       Int?     @map("edited_by")

  // Relations
  homes     Homes[]
  employees Employees? @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_partners_employee_id_fkey")
  regions   Regions?   @relation(fields: [regionId], references: [regionId], onUpdate: NoAction, map: "employee_partners_region_id_fkey")
  umkm      Umkm[]

  @@map("partners")
}


model Regions {
  regionId   Int       @id @default(autoincrement()) @map("region_id")
  regionName String    @map("region_name") @db.VarChar(150)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  Int?      @map("created_by") @default(2)
  editedBy   Int?      @map("edited_by")

  // Relations
  employees Employees[]
  homes     Homes[]
  partners  Partners[]
  umkm      Umkm[]
  galleries Gallery[]

  @@map("regions")
}

model Roles {
  id       Int    @id @default(autoincrement())
  roleName String @unique @map("role_name") @db.VarChar(50)

  // Relations
  staffs Staffs[]

  @@map("roles")
}

model Staffs {
  id          Int       @id @default(autoincrement())
  staffName   String    @map("staff_name") @db.VarChar(100)
  gender      Gender    @map("gender")
  birthplace  String?   @db.VarChar(50)
  birthdate   DateTime? @db.Date
  address     String?   @db.VarChar(255)
  phoneNumber String?   @map("phone_number") @db.VarChar(15)
  email       String?   @unique @db.VarChar(100)
  nik         String    @unique @db.VarChar(20)
  roleId      Int       @map("role_id")
  position    String?   @db.VarChar(100)
  staffPict   String?   @map("staff_pict") @db.VarChar(255)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy   Int?      @map("created_by") @default(2)
  editedBy    Int?      @map("edited_by")

  // Relations
  roles Roles   @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users Users[]

  @@map("staffs")
}


model Umkm {
  id              Int       @id @default(autoincrement())
  partnerId       Int?      @map("partner_id")
  ownerName       String?   @map("owner_name") @db.VarChar(255)
  businessName    String?   @map("business_name") @db.VarChar(255)
  businessAddress String?   @map("business_address")
  regionId        Int?      @map("region_id")
  subdistrictName String?   @map("subdistrict_name") @db.VarChar(150)
  postalCode      String?   @map("postal_code") @db.VarChar(10)
  umkmCoordinate  String?   @map("umkm_coordinate") @db.VarChar(100)
  businessType    String?   @map("business_type") @db.VarChar(100)
  products        String?
  employeeId      Int?      @map("employee_id")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  waliId          Int?      @map("wali_id")
  childrenId      Int?      @map("children_id")
  umkmPict        String?   @map("umkm_pict") @db.VarChar(255)
  umkmPict2       String?   @map("umkm_pict_2") @db.VarChar(255)
  umkmPict3       String?   @map("umkm_pict_3") @db.VarChar(255)
  umkmPict4       String?   @map("umkm_pict_4") @db.VarChar(255)
  umkmPict5       String?   @map("umkm_pict_5") @db.VarChar(255)
  isActive        Boolean?  @default(true) @map("is_active")
  createdBy       Int?      @map("created_by") @default(2)
  editedBy        Int?      @map("edited_by")

  // Relations
  children  Children?  @relation(fields: [childrenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees Employees? @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  partners  Partners?  @relation(fields: [partnerId], references: [id], onUpdate: NoAction)
  regions   Regions?   @relation(fields: [regionId], references: [regionId], onUpdate: NoAction)
  wali      Wali?      @relation(fields: [waliId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  umkmVisits UmkmVisit[]
  umkmMonitoring UmkmMonitoring[]

  @@map("umkm")
}

model Users {
  userId   Int    @default(autoincrement()) @map("user_id")
  username String @unique @db.VarChar(30)
  password String @db.VarChar(255)
  staffId  Int?   @map("staff_id")

  // Relations
  staffs Staffs? @relation(fields: [staffId], references: [id], map: "fk_users_staff")

  @@map("users")
}

model Wali {
  id                Int       @id @default(autoincrement())
  employeeId        Int?      @map("employee_id")
  waliName          String    @map("wali_name") @db.VarChar(100)
  relation          String?   @db.VarChar(50)
  waliAddress       String?   @map("wali_address")
  addressCoordinate String?   @map("address_coordinate") @db.VarChar(50)
  waliPhone         String?   @map("wali_phone") @db.VarChar(20)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  waliPict          String?   @map("wali_pict") @db.VarChar(255)
  nik               String?   @db.VarChar(30)
  waliJob           String?   @map("wali_job") @db.VarChar(50)
  createdBy         Int?      @map("created_by") @default(2)
  editedBy          Int?      @map("edited_by")

  // Relations
  homes     Homes[]
  umkm      Umkm[]
  employees Employees? @relation(fields: [employeeId], references: [id], onUpdate: NoAction)

  @@map("wali")
}

model FamilyVisit {
  id              Int       @id @default(autoincrement())
  homeId          Int       @map("home_id")
  visitDate       DateTime  @map("visit_date") @db.Date
  visitNumber     Int       @map("visit_number")
  officer         String    @map("officer") @db.VarChar(100)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy       Int?      @map("created_by") @default(2)
  editedBy        Int?      @map("edited_by")

  // Relations
  homes          Homes     @relation(fields: [homeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  familyVisitDocs FamilyVisitDocs[]

  @@map("family_visits")
}

model FamilyVisitDocs {
  id              Int         @id @default(autoincrement())
  familyVisitId   Int         @map("family_visit_id")
  name            String      @map("name") @db.VarChar(255)
  urlDoc          String      @map("url_doc") @db.VarChar(255)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  familyVisits    FamilyVisit @relation(fields: [familyVisitId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("family_visit_docs")
}

model UmkmVisit {
  id                   Int       @id @default(autoincrement())
  umkmId               Int       @map("umkm_id")
  visitNumber          Int       @map("visit_number")
  assistanceDate       DateTime  @map("assistance_date") @db.Date
  assistanceType       String    @map("assistance_type") @db.VarChar(100)
  itemType             String    @map("item_type") @db.VarChar(50)
  assistanceAmount     Int       @map("assistance_amount")
  assistanceSource     String    @map("assistance_source") @db.VarChar(100)
  value                Float     @map("value")
  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy            Int?      @map("created_by") @default(2)
  editedBy             Int?      @map("edited_by")

  // Relations
  umkm                 Umkm      @relation(fields: [umkmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  umkmVisitDocs        UmkmVisitDocs[]

  @@map("umkm_visits")
}

model UmkmVisitDocs {
  id              Int        @id @default(autoincrement())
  umkmVisitId     Int        @map("umkm_visit_id")
  name            String     @map("name") @db.VarChar(255)
  urlDoc          String     @map("url_doc") @db.VarChar(255)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  umkmVisits      UmkmVisit  @relation(fields: [umkmVisitId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("umkm_visit_docs")
}

model UmkmMonitoring {
  id                      Int       @id @default(autoincrement())
  umkmId                  Int       @map("umkm_id")
  visitNumber             Int       @map("visit_number")
  monitoringDate          DateTime  @map("monitoring_date") @db.Date
  surveyor                String    @map("surveyor") @db.VarChar(100)
  turnoverBefore          Float?    @map("turnover_before")
  turnoverAfter           Float?    @map("turnover_after")
  workersBefore           Int?      @map("workers_before")
  workersAfter            Int?      @map("workers_after")
  productionBefore        Float?    @map("production_before")
  productionAfter         Float?    @map("production_after")
  customersBefore         Int?      @map("customers_before")
  customersAfter          Int?      @map("customers_after")
  benefitLevel            String?   @map("benefit_level") @db.VarChar(50)
  challenges              String?   @map("challenges") @db.Text
  developmentNeeds        String?   @map("development_needs") @db.Text
  otherNotes              String?   @map("other_notes") @db.Text
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy               Int?      @map("created_by") @default(2)
  editedBy                Int?      @map("edited_by")

  // Relations
  umkm                    Umkm      @relation(fields: [umkmId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  umkmMonitoringDocs      UmkmMonitoringDocs[]

  @@map("umkm_monitoring")
}

model UmkmMonitoringDocs {
  id              Int              @id @default(autoincrement())
  umkmMonitoringId Int             @map("umkm_monitoring_id")
  name            String           @map("name") @db.VarChar(255)
  urlDoc          String           @map("url_doc") @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  umkmMonitoring  UmkmMonitoring   @relation(fields: [umkmMonitoringId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("umkm_monitoring_docs")
}

model ChildAssistance {
  id                   Int       @id @default(autoincrement())
  childrenId           Int       @map("children_id")
  assistanceNumber     Int       @map("assistance_number")
  assistanceDate       DateTime  @map("assistance_date") @db.Date
  assistanceType       String    @map("assistance_type") @db.VarChar(100)
  assistanceProvider   String    @map("assistance_provider") @db.VarChar(100)
  assistanceAmount     Float     @map("assistance_amount")
  educationLevel       String?   @map("education_level") @db.VarChar(100)
  educationGrade       String?   @map("education_grade") @db.VarChar(100)
  schoolName           String?   @map("school_name") @db.VarChar(200)
  age                  Int?      @db.SmallInt
  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy            Int?      @map("created_by") @default(2)
  editedBy             Int?      @map("edited_by")

  // Relations
  children             Children           @relation(fields: [childrenId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  childAssistanceDocs  ChildAssistanceDocs[]

  @@map("child_assistance")
}

model ChildAssistanceDocs {
  id                  Int             @id @default(autoincrement())
  childAssistanceId   Int             @map("child_assistance_id")
  name                String          @map("name") @db.VarChar(255)
  urlDoc              String          @map("url_doc") @db.VarChar(255)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  childAssistance     ChildAssistance @relation(fields: [childAssistanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("child_assistance_docs")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @map("name") @db.VarChar(100)
  slug      String    @unique @map("slug") @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy Int?      @map("created_by") @default(2)
  editedBy  Int?      @map("edited_by")

  // Relations
  galleryCategories GalleryCategory[]

  @@map("categories")
}

model Gallery {
  id          Int       @id @default(autoincrement())
  s3Path      String    @map("s3_path") @db.VarChar(500)
  caption     String?   @db.Text
  regionId    Int?      @map("region_id")
  galleryDate DateTime? @map("gallery_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy   Int?      @map("created_by") @default(2)
  editedBy    Int?      @map("edited_by")

  // Relations
  galleryCategories GalleryCategory[]
  regions           Regions?         @relation(fields: [regionId], references: [regionId], onUpdate: NoAction)

  @@map("galleries")
}

model GalleryCategory {
  id         Int      @id @default(autoincrement())
  galleryId  Int      @map("gallery_id")
  categoryId Int      @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  gallery    Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([galleryId, categoryId])
  @@map("gallery_categories")
}